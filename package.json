{
  "name": "finclub-online",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "FinClub Online",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "preview": "quasar serve dist/spa",
    "dev:android": "quasar dev -m capacitor -T android",
    "dev:ios": "quasar dev -m capacitor -T ios",
    "build:android": "quasar build -m capacitor -T android",
    "build:ios": "quasar build -m capacitor -T ios",
    "prepare:android": "quasar build -m capacitor -T android --skip-pkg",
    "prepare:ios": "quasar build -m capacitor -T ios --skip-pkg",
    "icons:mobile": "icongenie generate -p icongenie-app.json && icongenie generate -p icongenie-push.json",
    "icons:verify": "icongenie verify -p icongenie-app.json && icongenie verify -p icongenie-push.json",
    "test:mobile": "node --test tests/*.test.mjs",
    "firebase:import": "node scripts/import-firebase.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/action-sheet": "^8.1.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.3",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "@quasar/extras": "^2.1.0",
    "@telegram-apps/sdk": "^3.11.8",
    "@vueuse/core": "^14.2.1",
    "dayjs": "^1.11.19",
    "days": "^1.1.1",
    "firebase": "^12.10.0",
    "ky": "^1.14.2",
    "pinia": "^4.0.2",
    "quasar": "^2.35.1",
    "tailwindcss": "^3.4.9",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.2",
    "@quasar/icongenie": "^7.0.0",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "sass-embedded": "^1.93.3",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": "^22.22.0 || >=24.11.0"
  }
}
